# Application
BASE_URL=http://localhost:3000

# AWS SSM — required unless TEST_USERNAME/TEST_PASSWORD are set
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SSM path environment segment: /playwright/{TEST_ENV}/{userIdentifier}/username|password
TEST_ENV=dev

# Local dev bypass — set both to skip SSM entirely
TEST_USERNAME=
TEST_PASSWORD=
